# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
BOT_PASSCODE=          # required to /unlock the bot
MAX_UNLOCK_ATTEMPTS=5
UNLOCK_COOLDOWN_MIN=15
ADMIN_USER_IDS=            # comma-separated Telegram user ids; empty = open (dev only)

# ---- LocationIQ (business search, OSM-based, free tier no card) ----
# my.locationiq.com/dashboard#api-keys
LOCATIONIQ_API_KEY=

# ---- Resend (email) ----
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Local Web Studio
REPLY_TO=you@example.com

# Required for commercial email (CAN-SPAM). Sending is refused if empty.
SENDER_POSTAL_ADDRESS=Your Name, 123 Your St, Houston, TX 77002

# ---- Demo hosting ----
DEMO_BASE_URL=http://localhost:8080
UNSUBSCRIBE_BASE=http://localhost:8080
DEMO_EXPIRE_HOURS=336
PORT=8080

# ---- Pricing / pipeline ----
PRICE_USD=99
PIPELINE_TOKEN=change-me-to-a-random-string

# ---- Twilio SMS (free trial: 100 SMS, no credit card) ----
# https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Hunter.io (free tier: 25 email searches/month) ----
# https://hunter.io
HUNTER_API_KEY=

# ---- Apollo.io (free tier: 100 enrichment credits) ----
# https://www.apollo.io
APOLLO_API_KEY=

# ---- Turso (hosted libSQL database — survives redeploys with no local disk) ----
# Required on Vercel Production + Preview. Without these, the function uses an
# empty local DB (homepage still works; data does not persist across cold starts).
# Use the same Turso database as Render so demo sites and leads stay in sync.
# turso db show restaurant-ai-bot --url / turso db tokens create restaurant-ai-bot
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# On Vercel also set these so generated demo links and opt-out URLs point at
# the live deployment, not the Render default:
# DEMO_BASE_URL=https://restaurant-ai-bot-two.vercel.app
# UNSUBSCRIBE_BASE=https://restaurant-ai-bot-two.vercel.app

# ---- Render persistent storage ----
DEMO_DIR=/app/persist/demos
