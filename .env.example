# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
BOT_PASSCODE=          # required to /unlock the bot
MAX_UNLOCK_ATTEMPTS=5
UNLOCK_COOLDOWN_MIN=15
ADMIN_USER_IDS=            # comma-separated Telegram user ids; empty = open (dev only)

# ---- LocationIQ (business search, OSM-based, free tier no card) ----
# my.locationiq.com/dashboard#api-keys
LOCATIONIQ_API_KEY=

# ---- Resend (email) ----
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Local Web Studio
REPLY_TO=you@example.com

# Required for commercial email (CAN-SPAM). Sending is refused if empty.
SENDER_POSTAL_ADDRESS=Your Name, 123 Your St, Houston, TX 77002

# ---- Demo hosting ----
DEMO_BASE_URL=http://localhost:8080
UNSUBSCRIBE_BASE=http://localhost:8080
DEMO_EXPIRE_HOURS=72
PORT=8080

# ---- Pricing / pipeline ----
PRICE_USD=299
PIPELINE_TOKEN=change-me-to-a-random-string
