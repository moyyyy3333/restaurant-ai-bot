# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
BOT_PASSCODE=          # required to /unlock the bot
MAX_UNLOCK_ATTEMPTS=5
UNLOCK_COOLDOWN_MIN=15
ADMIN_USER_IDS=            # comma-separated Telegram user ids; empty = open (dev only)

# ---- LocationIQ (business search, OSM-based, free tier no card) ----
# my.locationiq.com/dashboard#api-keys
LOCATIONIQ_API_KEY=

# ---- Google Places (hours, phone, website check; omit hours when missing) ----
GOOGLE_PLACES_API_KEY=

# ---- Resend (email) ----
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Local Web Studio
REPLY_TO=you@example.com

# Required for commercial email (CAN-SPAM). Sending is refused if empty.
SENDER_POSTAL_ADDRESS=Your Name, 123 Your St, Houston, TX 77002

# ---- Demo hosting ----
# Set this to the one public Render service URL in production. Demo and
# unsubscribe links inherit it; override either only for local development.
PUBLIC_BASE_URL=http://localhost:8080
DEMO_BASE_URL=
UNSUBSCRIBE_BASE=
DEMO_EXPIRE_HOURS=336
PORT=8080

# ---- Pricing / pipeline ----
PRICE_USD=99
BUILD_PRICE_USD=99
CARE_MONTHLY_USD=29
CARE_YEARLY_USD=249
PIPELINE_TOKEN=change-me-to-a-random-string
# Optional alias for the operator dashboard (?k=). Falls back to PIPELINE_TOKEN.
BOARD_KEY=

# ---- Stripe claim stub (optional — /ops and /claim work without these) ----
# $99 one-time website build; Care is $29/mo or $249/yr. Do not use $79.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Price IDs. If empty, Checkout uses inline price_data from the USD amounts above.
STRIPE_PRICE_BUILD=
STRIPE_PRICE_CARE_MONTHLY=
STRIPE_PRICE_CARE_YEARLY=

# ---- Twilio SMS (free trial: 100 SMS, no credit card) ----
# https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Hunter.io (free tier: 25 email searches/month) ----
# https://hunter.io
HUNTER_API_KEY=

# ---- Apollo.io (free tier: 100 enrichment credits) ----
# https://www.apollo.io
APOLLO_API_KEY=

# ---- Turso (hosted libSQL database — survives Render deploys) ----
# Required in production. Without these, the service uses a local SQLite file.
# turso db show restaurant-ai-bot --url / turso db tokens create restaurant-ai-bot
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Render persistent storage ----
DEMO_DIR=/app/persist/demos
